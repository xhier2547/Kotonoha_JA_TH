# Supabase (Required for Member Auth & Cloud Sync across devices)
# Get these from Supabase Dashboard -> Project Settings -> Data API / API Keys
# Project URL example: https://your-project-ref.supabase.co (NOT sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / Anon public key (sb_publishable_... or legacy anon key; NEVER sb_secret_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
